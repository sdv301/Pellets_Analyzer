# Auto detect text files and perform LF normalization on checkout
* text=auto

# Shell scripts and Docker entrypoint must always have LF line endings
*.sh text eol=lf
Dockerfile text eol=lf

# Explicit text files
*.py text
*.html text
*.css text
*.js text
*.json text
*.md text
*.yml text
*.yaml text
*.ini text
*.txt text
